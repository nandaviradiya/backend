NODE_ENV=production
PORT=3000
CORS_ORIGINS=*

# Set by Railway automatically when you add PostgreSQL plugin:
DATABASE_URL=

# Set by Railway automatically when you add Redis plugin:
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Firebase (optional)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ML Service
ML_SERVICE_URL=

# Trading thresholds
DEFAULT_SIGNAL_SCORE_THRESHOLD=65
DEFAULT_RVOL_THRESHOLD=1.8
NOTIFICATION_COOLDOWN_MINUTES=30

# Encryption key (32 bytes hex = 64 chars)
BROKER_TOKEN_ENCRYPTION_KEY=

# Admin
ADMIN_EMAILS=

# AngelOne SmartAPI
ANGELONE_API_KEY=
ANGELONE_CLIENT_ID=
ANGELONE_CLIENT_PIN=
ANGELONE_TOTP_SECRET=
ANGELONE_API_BASE=https://apiconnect.angelone.in
